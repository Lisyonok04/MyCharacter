# Скопируй в .env, если нужны нестандартные значения.
# Без .env compose берёт значения по умолчанию и всё работает как есть.

POSTGRES_DB=mycharacter
POSTGRES_USER=mc
POSTGRES_PASSWORD=mc_local_pass
# Если 5432 занят локальным Postgres — поменяй, например на 5433
POSTGRES_PORT=5432
ADMINER_PORT=8081
TZ=Europe/Moscow
